# Required for the discovery run only. Replay never reads this.
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
CUA_MODEL=claude-sonnet-5
TARGET_APP_PORT=4173
OPERATOR_CONSOLE_PORT=4180
# Fake training credentials for the mock app. Non-secret and synthetic, but the
# capabilities declare them, so replay fails without them.
CUA_SECRET_OPERATOR_ID=OPR001
CUA_SECRET_OPERATOR_PASSWORD=training-only
CUA_SECRET_OVERRIDE_CODE=4417
