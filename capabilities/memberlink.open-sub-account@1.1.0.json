{
  "schemaVersion": "1.0.0",
  "id": "memberlink.open-sub-account",
  "version": "1.1.0",
  "name": "Open a sub-account and post it",
  "description": "Given a member number, an account type and an opening deposit, open a sub-account in MemberLink and POST it, returning the reference number. The posting step is irreversible, exceeds the capability\u2019s unattended risk ceiling, and therefore requires a human decision at replay time. Re-running for a member who already holds that product reports SUB_ACCOUNT_EXISTS instead of opening a second one.",
  "state": "approved",
  "surface": {
    "kind": "web",
    "entry": "{{env.baseUrl}}/t/summit/",
    "application": {
      "vendor": "memberlink",
      "product": "core-servicing",
      "versionRange": "3.x"
    },
    "viewport": {
      "width": 1280,
      "height": 800
    }
  },
  "inputs": [
    {
      "name": "memberId",
      "type": "string",
      "description": "The member's 6-digit account number.",
      "required": true,
      "sensitivity": "identifier",
      "pattern": "^\\d{6}$",
      "example": "123456"
    },
    {
      "name": "accountType",
      "type": "string",
      "description": "Product to open.",
      "required": true,
      "sensitivity": "public",
      "enum": [
        "SHARE SAVINGS",
        "VACATION CLUB",
        "CERTIFICATE"
      ],
      "example": "VACATION CLUB"
    },
    {
      "name": "openingDeposit",
      "type": "money",
      "description": "Opening deposit in USD. Deposits of $1,000 or more require a supervisor override.",
      "required": true,
      "sensitivity": "financial",
      "example": 250
    }
  ],
  "outputs": [
    {
      "name": "reference",
      "type": "string",
      "description": "Reference number shown on the confirmation screen.",
      "sensitivity": "public",
      "required": true
    }
  ],
