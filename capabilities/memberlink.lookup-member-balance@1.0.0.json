            ]
          }
        }
      ],
      "maxAttempts": 2,
      "scope": "global"
    },
    {
      "id": "re-authenticate",
      "description": "Sign on again after the application expires the session mid-run.",
      "when": {
        "kind": "textPresent",
        "value": "Your session has expired",
        "match": "contains"
      },
      "do": [
        {
          "type": "fill",
          "target": {
            "description": "Operator ID field on the sign-on screen",
            "framePath": [
              "*"
            ],
            "strategies": [
              {
                "tier": "structural",
                "kind": "nearText",
                "anchor": "Operator ID:",
                "anchorMatch": "exact",
                "direction": "following",
                "control": "textbox",
                "ordinal": 1
