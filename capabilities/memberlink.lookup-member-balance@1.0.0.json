      "action": {
        "type": "fill",
        "target": {
          "description": "Member Number",
          "framePath": [
            "mainFrame"
          ],
          "strategies": [
            {
              "tier": "structural",
              "kind": "nearText",
              "anchor": "Member Number:",
              "anchorMatch": "exact",
              "direction": "following",
              "control": "textbox",
              "ordinal": 1
