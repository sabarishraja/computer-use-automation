            {
              "tier": "structural",
              "kind": "nearText",
              "anchor": "Password",
              "anchorMatch": "contains",
              "direction": "following",
              "control": "textbox",
              "ordinal": 1
            },
            {
              "tier": "structural",
              "kind": "fieldName",
