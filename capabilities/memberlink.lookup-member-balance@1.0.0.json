          "value": "{{env.secret_OPERATOR_ID}}"
        },
        {
          "type": "fill",
          "target": {
            "description": "Password field on the sign-on screen",
            "framePath": [
              "*"
            ],
            "strategies": [
              {
                "tier": "structural",
                "kind": "nearText",
                "anchor": "Password:",
                "anchorMatch": "exact",
                "direction": "following",
                "control": "textbox",
                "ordinal": 1
              },
              {
                "tier": "structural",
                "kind": "fieldName",
                "name": "pw"
              }
            ]
          },
          "value": "{{env.secret_OPERATOR_PASSWORD}}"
        },
        {
          "type": "click",
          "target": {
            "description": "Sign On button",
            "framePath": [
              "*"
            ],
            "strategies": [
              {
                "tier": "semantic",
                "kind": "role",
                "role": "button",
                "name": "Sign On",
                "match": "exact"
              }
            ]
          }
        }
      ],
      "maxAttempts": 1,
      "scope": "global"
