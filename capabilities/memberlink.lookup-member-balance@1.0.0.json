  "outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "The member number is well-formed but no such member exists at this institution.",
      "when": {
        "kind": "textPresent",
        "value": "No member record found",
        "match": "contains"
      },
      "message": "No member record exists for {{inputs.memberId}}.",
      "partialOutputs": []
    },
    {
      "code": "MEMBER_RESTRICTED",
      "description": "The member record exists but this operator is not authorised to view it.",
      "when": {
        "kind": "textPresent",
        "value": "is not authorized to view this member record.",
        "match": "contains",
        "framePath": [
          "mainFrame"
        ]
      },
      "message": "Access to member {{inputs.memberId}} is restricted for this operator.",
      "partialOutputs": []
    }
  ],
  "globalRecovery": [
    {
      "id": "dismiss-maintenance-notice",
      "description": "Clear the scheduled-maintenance interstitial that the app can interpose on any screen.",
      "when": {
        "kind": "textPresent",
        "value": "Scheduled maintenance",
        "match": "contains"
      },
      "do": [
        {
          "type": "click",
          "target": {
            "description": "Continue button on the maintenance notice",
            "framePath": [
              "*"
            ],
            "strategies": [
              {
                "tier": "semantic",
                "kind": "role",
                "role": "button",
                "name": "Continue",
                "match": "exact"
              }
            ]
          }
        }
      ],
      "maxAttempts": 2,
      "scope": "global"
    },
    {
      "id": "acknowledge-disclosure",
      "description": "Acknowledge the monitoring disclosure some institutions interpose after sign-on.",
      "when": {
        "kind": "textPresent",
        "value": "Activity in this system is monitored",
        "match": "contains"
      },
      "do": [
        {
          "type": "click",
          "target": {
            "description": "Acknowledge button on the disclosure screen",
            "framePath": [
              "*"
