    {
      "id": "s09-extract",
      "intent": "Extract the SHARE SAVINGS current balance.",
      "action": {
        "type": "extract",
        "target": {
          "description": "cell control",
          "framePath": [
            "mainFrame"
          ],
          "strategies": [
            {
              "tier": "positional",
              "kind": "tableCell",
              "rowContains": "SHARE SAVINGS",
              "column": "Current Balance"
