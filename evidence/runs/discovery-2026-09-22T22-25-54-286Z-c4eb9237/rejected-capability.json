{
  "schemaVersion": "1.0.0",
  "id": "memberlink.open-sub-account",
  "version": "1.0.0",
  "name": "Open a sub-account and reach the confirmation screen",
  "description": "Given a member number, an account type and an opening deposit, walk MemberLink to the sub-account confirmation screen and return the reference number. Stops at confirmation: posting the account is an irreversible step and is gated by policy.",
  "state": "draft",
  "surface": {
    "kind": "web",
    "entry": "{{env.baseUrl}}/t/summit/",
    "application": {
      "vendor": "memberlink",
      "product": "core-servicing",
      "versionRange": "3.x"
    },
    "viewport": {
      "width": 1280,
      "height": 800
    }
  },
  "inputs": [
    {
      "name": "memberId",
      "type": "string",
      "description": "The member's 6-digit account number.",
      "required": true,
      "sensitivity": "identifier",
      "pattern": "^\\d{6}$",
      "example": "[id:0cdf7e721a]"
    },
    {
      "name": "accountType",
      "type": "string",
      "description": "Product to open.",
      "required": true,
      "sensitivity": "public",
      "enum": [
        "SHARE SAVINGS",
        "VACATION CLUB",
        "CERTIFICATE"
      ],
      "example": "VACATION CLUB"
    },
    {
      "name": "openingDeposit",
      "type": "money",
      "description": "Opening deposit in USD. Deposits of $1,000 or more require a supervisor override.",
      "required": true,
      "sensitivity": "financial",
      "example": 250
